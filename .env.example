# Porta do servidor (FastAPI Cloud expõe a porta que o app escuta)
PORT=3000

# Banco de dados. Produção no FastAPI Cloud: Postgres gerenciado (Neon),
# provisionado pela integração da plataforma. Local/Docker sem DATABASE_URL:
# tudo é armazenado em arquivo SQLite em CHATGPT_PROXY_HOME (mesmo modelo do
# projeto anterior — basta montar o diretório como volume).
DATABASE_URL=
CHATGPT_PROXY_HOME=

# Engine upstream: litellm (default) ou httpx (port fiel do proxy original)
UPSTREAM_ENGINE=litellm

# Modelo usado quando o cliente pede um modelo fora da allowlist (ex.: claude-*)
DEFAULT_MODEL=gpt-5.1-codex

# Chave de admin dos endpoints /admin/* (obrigatória em produção multi-instância)
ADMIN_API_KEY=

# Segredo do cookie de sessão do fluxo /login
COOKIE_SECRET=

# Backend Codex do ChatGPT Plan (só altere se souber o que está fazendo)
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
